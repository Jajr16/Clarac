<!DOCTYPE html>
<html>

<head>
  <title>
    <%= title %>
  </title>
  <script src="https://code.jquery.com/jquery-2.2.4.min.js"
    integrity="sha256-BbhdlvQf/xTY9gja0Dq3HiwQF8LaCRTXxZKRutelT44=" crossorigin="anonymous"></script>
  <link rel="stylesheet" type="text/css" href="/stylesheets/normalize.css">
  <link rel="stylesheet" type="text/css" href="/stylesheets/general.css">
  <link rel="stylesheet" type="text/css" href="/stylesheets/LogIn.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://kit.fontawesome.com/9c84429ff8.js" crossorigin="anonymous"></script>
</head>

<body>
  <% if (errorMessage) { %>
    <script>
      Swal.fire({
        icon: "error",
        title: 'Hubo un error :(',
        text: "<%= errorMessage %>",
      }).then(() => {
        window.location.href = '/';
      });;
    </script>
    <% } %>
      <header>
        <%- include('partials/nav_log.ejs') %>
      </header>
      <div class="LogIn">
        <div id="errorMessage"></div>
        <form action="" name="loginForm" id="loginForm" method="POST">
          <h1 class="title">Iniciar Sesión</h1>
          <!--Nombre-->
          <div class="field">
            <label class="label">Usuario</label>
            <input autocomplete="off" class="input_Login" type="text" name="loginUser" id="loginUser"
              placeholder="Ingresa tu usuario" required
              value="ajimenez">
          </div>
          <!--Contraseña-->
          <div class="field">
            <label class="label">Contraseña</label>
            <input autocomplete="off" class="input_Login" type="password" name="loginPass" id="loginPass"
              placeholder="Ingresa tu contraseña" required
              value="Clarac2017">
          </div>
          <input type="submit" value="Aceptar" class="input_Login success_login">
        </form>
      </div>
</body>
<script type="module" src="/javascripts/login/loginMain.js"></script>
<script type="text/javascript" src="/javascripts/Mayusculas.js"></script>
<script type="text/javascript" src="/javascripts/textVal.js"></script>

</html>